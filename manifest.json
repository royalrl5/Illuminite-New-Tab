{
	"manifest_version": 3,
	"name": "Illuminite New Tab",
	"version": "1.2.1",
	"description": "Turns your new tab into a GNOME-style desktop with web apps, search, wallpapers, sound FX and a screensaver.",
	"icons": {
		"16": "icons/browos-logo.png",
		"32": "icons/browos-logo.png",
		"48": "icons/browos-logo.png",
		"128": "icons/browos-logo.png"
	},
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "browos@local.dev",
			"strict_min_version": "109.0"
		}
	},
	"permissions": [
		"storage",
		"unlimitedStorage"
	]
}
